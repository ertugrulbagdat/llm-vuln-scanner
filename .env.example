# API anahtarları yalnızca .env üzerinden okunur, koda veya raporlara asla
# gömülmez (§11 — Kimlik bilgisi hijyeni). Bu dosyayı .env olarak kopyalayın.
# .env dosyası .gitignore'dadır; asla commit etmeyin.

# Run Store bağlantı dizesi (boş bırakılırsa sqlite:///llm_vuln_scanner.db)
LLM_SCANNER_DB_URL=

# Faz 1 adaptörleri için
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
